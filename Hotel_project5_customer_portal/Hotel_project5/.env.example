# Sao chép file này thành .env và điền cấu hình MySQL trên máy của bạn.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_management_erd
DB_CONNECT_TIMEOUT=10
HOTEL_API_URL=http://127.0.0.1:8000

# Đặt chuỗi bí mật ngẫu nhiên, tối thiểu 32 ký tự.
HOTEL_AUTH_SECRET=replace-this-with-a-long-random-secret-key-at-least-32-chars
