# Sao chép file này thành .env và điền cấu hình MySQL trên máy của bạn.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=dinomtp16
DB_NAME=hotel_management_erd
DB_CONNECT_TIMEOUT=10
HOTEL_API_URL=http://127.0.0.1:8000

# Đặt chuỗi bí mật ngẫu nhiên, tối thiểu 32 ký tự.
HOTEL_AUTH_SECRET=ucaIHP1Q3zRJpd645MuJj0jY9sP-NWf4zmVl41GD9mM

# Tài khoản nhận tiền QR VietQR (dùng mã ngân hàng ngắn, ví dụ Vietcombank).
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
PAYMENT_QR_IMAGE_URL=https://vietqr.app/img

# SePay webhook: ưu tiên HMAC_SHA256; dùng cùng Secret Key đã cấu hình trong SePay.
SEPAY_WEBHOOK_AUTH_MODE=HMAC_SHA256
SEPAY_WEBHOOK_SECRET=
# Chỉ điền nếu tài khoản nhận webhook khác PAYMENT_BANK_ACCOUNT.
SEPAY_WEBHOOK_ACCOUNT_NUMBER=
# Chỉ dùng khi SePay được cấu hình xác thực bằng API Key thay vì HMAC.
SEPAY_WEBHOOK_API_KEY=
