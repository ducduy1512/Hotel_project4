# Hotel Management dùng SQLite nhúng trong Python.
# KHÔNG cần DB_HOST, DB_PORT, DB_USER, DB_PASSWORD hoặc MySQL Server.

# Tùy chọn: đổi vị trí file SQLite (mặc định: data/hotel_management.db).
# HOTEL_SQLITE_PATH=./data/hotel_management.db

# Tùy chọn: địa chỉ/port chạy ứng dụng.
# HOTEL_HOST=127.0.0.1
# HOTEL_PORT=8000

# VietQR: chỉ điền 3 biến dưới đây khi muốn bật chuyển khoản QR.
# Để trống thì QR tự động không khả dụng; ứng dụng vẫn chạy bình thường.
PAYMENT_BANK_CODE=Vietcombank
PAYMENT_BANK_ACCOUNT=0123456789
PAYMENT_ACCOUNT_NAME=Admin
PAYMENT_QR_IMAGE_URL=https://vietqr.app/img

# SePay webhook: chỉ điền secret khi đã cấu hình webhook trên tài khoản SePay.
SEPAY_WEBHOOK_AUTH_MODE=HMAC_SHA256
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_ACCOUNT_NUMBER=0123456789
SEPAY_WEBHOOK_API_KEY=

# Không bắt buộc cấu hình HOTEL_AUTH_SECRET.
# Ứng dụng tự tạo khóa xác thực cục bộ tại data/.auth_secret nếu chưa có.
